# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# JWT auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_REFRESH_EXPIRES_IN=30d

# OTP (login confirmation)
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP (mail sending) — optional; MailService logs to console when unset.
# See README/plan for how to generate a Gmail app password.
# SMTP_URL=smtp://YOUR_EMAIL@gmail.com:APP_PASSWORD@smtp.gmail.com:587
# MAIL_FROM="Your App Name <YOUR_EMAIL@gmail.com>"
